{
  "_comment": "Copy to .claude/settings.local.json (gitignored) for MACHINE-LOCAL overrides. Everything here is convenience only: it stops routine, non-destructive commands from re-prompting. The safety properties live in the committed .claude/settings.json and in .claude/hooks/guard-bash.sh — a local allow rule must never be used to work around them. The read-only Vercel CLI commands are already allowed in the committed settings.json (they need `vercel login`, or VERCEL_TOKEN exported in your own shell — never pass --token). DELIBERATELY NOT ALLOWLISTED, keep them prompting: git push, gh pr create, gh pr merge, git worktree add/remove, npm install/uninstall, and every deploying or mutating Vercel command. The mcp__vercel__* deny entries below are inert unless you opt in to the Vercel MCP server (see README) — they are pre-loaded so that opting in is safe by default; Vercel MCP is Public Beta, has no read-only mode, and its deploy/buy tools can touch production and real money. Keep this file secret-free: it is a settings file, not a place for tokens. Drop the _comment key if you prefer strict-minimal JSON.",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm ci:*)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run check:*)",
      "Bash(npm run e2e:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx playwright install:*)",
      "Bash(npx playwright show-report:*)",
      "Bash(npx biome:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(npm view:*)",
      "Bash(npm audit:*)",
      "Bash(npm ls:*)",
      "Bash(node -v)",
      "Bash(npm -v)",
      "Bash(npx --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show-ref:*)",
      "Bash(git worktree list:*)",
      "Bash(git remote get-url:*)",
      "Bash(gh --version)",
      "Bash(gh auth status:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(gitleaks:*)",
      "Bash(pre-commit run:*)"
    ],
    "deny": [
      "mcp__vercel__deploy_to_vercel",
      "mcp__vercel__buy_*",
      "mcp__vercel__get_access_to_vercel_url"
    ]
  }
}
